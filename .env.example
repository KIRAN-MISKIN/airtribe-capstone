## Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

## Database (Postgres)
DATABASE_URL=postgresql://user:pass@localhost:5432/chronos

## Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

## Worker
WORKER_CONCURRENCY=5
WORKER_QUEUE_NAME=job-queue
WORKER_FAILED_QUEUE_NAME=job-queue-failed

## BullMQ defaults
JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY=2000
REMOVE_ON_COMPLETE=100
REMOVE_ON_FAIL=500

## Observability / webhooks
WEBHOOK_SECRET=change-me

## Admin (BullBoard basic auth)
ADMIN_USER=admin
ADMIN_PASS=changeme

## JWT Authentication
JWT_SECRET=super-secret-key-for-chronos-123

## SMTP Configuration emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=your_email@gmail.com
